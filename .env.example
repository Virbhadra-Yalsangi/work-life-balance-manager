# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# Notifications are optional: the dashboard and planner work without them.

# --- Which channels get reminders (comma separated) ---
# Options: email, telegram, sms, voice. Twilio TRIAL accounts cannot send custom
# SMS/voice, so use "email,telegram" until you upgrade Twilio.
ENABLED_CHANNELS=email,telegram

# --- Telegram (free): create a bot with @BotFather ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Where reminders are sent ---
NOTIFICATION_TO_PHONE=+91XXXXXXXXXX
NOTIFICATION_TO_EMAIL=

# --- Twilio (SMS + voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- SendGrid (email) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
